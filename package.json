{
  "name": "tanvi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @tanvi/web",
    "db:dev": "npm run dev -w @tanvi/database",
    "db:migrate": "npm run migrate -w @tanvi/database",
    "db:seed": "npm run seed -w @tanvi/database",
    "dev": "npm run dev -w @tanvi/web",
    "build": "npm run build -w @tanvi/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
