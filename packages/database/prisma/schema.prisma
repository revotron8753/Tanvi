generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ---------- Identity and access ----------

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  name              String
  passwordHash      String
  isActive          Boolean   @default(true)
  mustChangePassword Boolean  @default(false)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  mfaSecretEnc      String?
  mfaEnabledAt      DateTime?
  /// Last accepted TOTP time-step, to reject replay of a code.
  mfaLastStep       Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  roles         UserRole[]
  sessions      Session[]
  recoveryCodes MfaRecoveryCode[]
  auditLogs     AuditLog[]
  movements     InventoryMovement[]
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  description String?

  roles RolePermission[]
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String    @unique
  /// false until the user passes MFA (when MFA is enabled for them)
  mfaVerified    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  idleExpiresAt  DateTime
  absoluteExpiresAt DateTime
  revokedAt      DateTime?
  ipHash         String?
  userAgent      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([absoluteExpiresAt])
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String?
  entityId   String?
  /// Never put secrets or full personal data here.
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Fixed-window counters for rate limiting (login, etc.).
model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  scope        String
  key          String
  requestHash  String?
  responseBody Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

// ---------- Catalogue ----------

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique
  name         String
  description  String?
  imageUrl     String?
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]

  @@index([isPublished, displayOrder])
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique
  name          String
  description   String?
  parentCode    String?       @unique
  status        ProductStatus @default(DRAFT)
  categoryId    String        @db.Uuid
  /// Integer paise.
  pricePaise    Int
  comparePricePaise Int?
  /// Null until the business supplies GST rates (see OPEN_QUESTIONS). Basis points, e.g. 500 = 5%.
  gstRateBps    Int?
  hsnCode       String?
  fabric        String?
  fit           String?
  neckline      String?
  sleeveLength  String?
  garmentLength String?
  pattern       String?
  careInstructions String?
  /// { columns: string[], rows: string[][] } — validated in the app (SizeChart schema).
  sizeChart     Json?
  isFeatured    Boolean       @default(false)
  isNewArrival  Boolean       @default(false)
  showOnHomepage Boolean      @default(false)
  tryOnEligible Boolean       @default(false)
  /// Private storage key of the APPROVED garment image sent to the try-on API (never served publicly).
  tryOnGarmentKey String?
  seoTitle      String?
  seoDescription String?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]
  variants ProductVariant[]
  wishlistItems WishlistItem[]
  tryOnJobs TryOnJob[]

  @@index([categoryId, status])
  @@index([status, publishedAt])
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  storageKey  String
  altText     String
  position    Int      @default(0)
  isPrimary   Boolean  @default(false)
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  sku        String   @unique
  size       String
  colour     String
  /// Overrides product price when set. Integer paise.
  pricePaise Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  balances InventoryBalance[]
  movements InventoryMovement[]
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size, colour])
  @@index([productId])
}

// ---------- Inventory ----------

model StockLocation {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  balances  InventoryBalance[]
  movements InventoryMovement[]
}

/// Available = onHand - reserved. Derived everywhere, never stored.
/// CHECK constraints (onHand >= 0, reserved >= 0, reserved <= onHand) are added in the migration SQL.
model InventoryBalance {
  id                String   @id @default(uuid()) @db.Uuid
  variantId         String   @db.Uuid
  locationId        String   @db.Uuid
  onHand            Int      @default(0)
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(2)
  updatedAt         DateTime @updatedAt

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([variantId, locationId])
  @@index([locationId])
}

enum InventoryMovementType {
  ADJUSTMENT
  RECEIPT
  RESERVE
  RELEASE
  SALE
  STORE_SALE
  RETURN_RESTOCK
  RETURN_QUARANTINE
}

/// Append-only ledger.
model InventoryMovement {
  id         String                @id @default(uuid()) @db.Uuid
  variantId  String                @db.Uuid
  locationId String                @db.Uuid
  type       InventoryMovementType
  /// Change to on-hand quantity (signed).
  deltaOnHand   Int                @default(0)
  /// Change to reserved quantity (signed).
  deltaReserved Int                @default(0)
  reason     String?
  reference  String?
  actorId    String?               @db.Uuid
  createdAt  DateTime              @default(now())

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  /// Restrict: the ledger is append-only, so staff with stock history are deactivated, never deleted.
  actor    User?          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([locationId])
}

// ---------- Content, marketing, shopping ----------

/// Editable site content, keyed (e.g. "home.hero", "policy.returns"). Shape per key is validated in the app.
model WebsiteContent {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  data        Json
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}

/// Marketing consent record. Nothing is sent from this table until an email provider is configured.
model NewsletterSubscriber {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  consentText String
  consentAt   DateTime @default(now())
  source      String?
  unsubscribedAt DateTime?
}

/// Anonymous (cookie-keyed) wishlist; linked to a customer account once customer auth exists.
model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  createdAt DateTime @default(now())

  items WishlistItem[]
}

model WishlistItem {
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([wishlistId, productId])
  @@index([productId])
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  items CartItem[]

  @@index([expiresAt])
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

// ---------- Orders and payments ----------

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUND_DUE
  REFUNDED
}

enum PaymentMethod {
  ONLINE
  COD
}

enum OrderSource {
  WEB
  WHATSAPP
  STORE
}

enum StockState {
  RESERVED
  COMMITTED
  RELEASED
  RESTOCKED
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  phone     String?
  createdAt DateTime @default(now())

  orders Order[]
}

model Order {
  id             String        @id @default(uuid()) @db.Uuid
  /// Customer-facing reference. Not a secret: it never grants access on its own.
  reference      String        @unique
  status         OrderStatus
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentMethod  PaymentMethod
  source         OrderSource   @default(WEB)
  customerId     String?       @db.Uuid
  contactName    String
  contactEmail   String
  contactPhone   String
  shipLine1      String
  shipLine2      String?
  shipCity       String
  shipState      String
  shipPincode    String
  subtotalPaise  Int
  discountPaise  Int           @default(0)
  shippingPaise  Int           @default(0)
  codFeePaise    Int           @default(0)
  /// Tax contained in (inclusive mode) or added to (exclusive mode) the total. Zero until tax is configured.
  taxPaise       Int           @default(0)
  totalPaise     Int
  taxMode        String
  couponCode     String?
  /// SHA-256 of the guest access token for the confirmation page.
  accessTokenHash String
  idempotencyKey String?       @unique
  reservationExpiresAt DateTime?
  cancelReason   String?
  staffNote      String?
  placedByStaffId String?      @db.Uuid
  invoiceNumber  String?       @unique
  invoicedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments PaymentAttempt[]
  shipment Shipment?

  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([customerId])
  @@index([reservationExpiresAt])
}

/// Immutable order-time snapshot (SPEC §6): later product edits never change history.
model OrderItem {
  id            String     @id @default(uuid()) @db.Uuid
  orderId       String     @db.Uuid
  variantId     String     @db.Uuid
  locationId    String     @db.Uuid
  name          String
  sku           String
  size          String
  colour        String
  hsnCode       String?
  quantity      Int
  unitPricePaise Int
  /// Discount allocated to this line (paise), after which tax is computed.
  discountPaise Int        @default(0)
  gstRateBps    Int?
  taxPaise      Int        @default(0)
  stockState    StockState @default(RESERVED)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
}

enum PaymentAttemptStatus {
  CREATED
  PAID
  FAILED
}

model PaymentAttempt {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @db.Uuid
  provider          String
  providerOrderId   String               @unique
  providerPaymentId String?
  amountPaise       Int
  status            PaymentAttemptStatus @default(CREATED)
  failureCode       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Inbound provider events, de-duplicated by (provider, eventId).
model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  outcome     String?

  @@unique([provider, eventId])
}

model Shipment {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @unique @db.Uuid
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime  @default(now())
  deliveredAt    DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id               String     @id @default(uuid()) @db.Uuid
  code             String     @unique
  type             CouponType
  /// PERCENT: basis points (1000 = 10%). FIXED: paise.
  value            Int
  minSubtotalPaise Int        @default(0)
  maxDiscountPaise Int?
  startsAt         DateTime?
  endsAt           DateTime?
  maxUses          Int?
  usedCount        Int        @default(0)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
}

/// Business settings (GSTIN, tax mode, shipping, COD…), one JSON document validated in the app.
model Setting {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model InvoiceCounter {
  year Int @id
  last Int
}

// ---------- Messaging (provider-independent outbox) ----------

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  DEAD
  SKIPPED
}

enum MessagePurpose {
  TRANSACTIONAL
  MARKETING
}

/// Durable outbox + delivery log. A row is written when a business event is recorded; a worker sends it later.
model OutboxMessage {
  id                String         @id @default(uuid()) @db.Uuid
  channel           String
  purpose           MessagePurpose @default(TRANSACTIONAL)
  event             String
  orderId           String?        @db.Uuid
  toPhone           String
  templateName      String?
  language          String?
  variables         Json
  /// Prevents the same event producing two messages.
  dedupeKey         String         @unique
  status            OutboxStatus   @default(PENDING)
  attempts          Int            @default(0)
  nextAttemptAt     DateTime       @default(now())
  providerMessageId String?
  /// Safe, normalised reason. Never a raw provider payload.
  lastError         String?
  createdAt         DateTime       @default(now())
  sentAt            DateTime?

  @@index([status, nextAttemptAt])
  @@index([orderId])
}

/// Recorded consent (marketing opt-in, try-on image capture). Append-only in spirit: withdrawal sets withdrawnAt.
model CustomerConsent {
  id            String    @id @default(uuid()) @db.Uuid
  purpose       String
  noticeVersion String
  locale        String
  noticeText    String
  phone         String?
  email         String?
  tryOnSessionId String?  @db.Uuid
  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?

  tryOnSession TryOnSession? @relation(fields: [tryOnSessionId], references: [id], onDelete: SetNull)

  @@index([purpose, grantedAt])
  @@index([tryOnSessionId])
}

// ---------- Try-on (provider-independent core) ----------

model KioskDevice {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  location   String?
  /// SHA-256 of the revocable device credential. Never an admin or customer session.
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?

  sessions TryOnSession[]
}

enum TryOnSource {
  KIOSK
  WEB
}

enum TryOnSessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

model TryOnSession {
  id            String             @id @default(uuid()) @db.Uuid
  source        TryOnSource
  deviceId      String?            @db.Uuid
  /// Short-lived opaque token (hash). Every asset and job is bound to exactly one session.
  tokenHash     String             @unique
  status        TryOnSessionStatus @default(ACTIVE)
  consentId     String?            @db.Uuid
  inputKey      String?
  createdAt     DateTime           @default(now())
  expiresAt     DateTime
  endedAt       DateTime?
  /// Set once all temporary assets have been deleted.
  assetsDeletedAt DateTime?

  device   KioskDevice?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  jobs     TryOnJob[]
  consents CustomerConsent[]
  links    ContinuationLink[]

  @@index([status, expiresAt])
  @@index([deviceId])
}

enum TryOnJobStatus {
  CREATED
  VALIDATING
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

model TryOnJob {
  id             String         @id @default(uuid()) @db.Uuid
  sessionId      String         @db.Uuid
  productId      String         @db.Uuid
  status         TryOnJobStatus @default(CREATED)
  idempotencyKey String         @unique
  providerJobId  String?
  resultKey      String?
  /// Cost in paise as reported/configured; null until known. Never guessed.
  costPaise      Int?
  errorCode      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  finishedAt     DateTime?

  session TryOnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([status, createdAt])
}

/// Short-lived QR continuation: grants only "open this product page". Carries no image or personal data.
model ContinuationLink {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  productId String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  session TryOnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
