# Copy to .env (never commit .env). Values below are placeholders, not secrets.

# --- Required ---------------------------------------------------------
# PostgreSQL connection string for the app. `npm run db:dev` starts a local one on port 54329.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tanvi"
# 32 random bytes, base64. Encrypts MFA secrets at rest. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# >= 32 chars. HMAC key for hashing IP addresses in logs. Generate: openssl rand -base64 48
APP_HASH_SECRET=""

# --- Optional ---------------------------------------------------------
# Admin session idle timeout (minutes, default 30) and absolute lifetime (hours, default 12).
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# --- Tests only -------------------------------------------------------
# Separate database whose name contains "test". DB-backed tests are skipped when unset.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5432/tanvi_test"

# --- One-off bootstrap (create-super-admin script only; do not keep in .env) ----
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=
